# Copia a deploy/.env (setup.sh lo hace y rellena DOMAIN y ADMIN_API_KEY por ti).

# Dominio público. Sin dominio propio, usa sslip.io con la IP del VPS (guiones en vez de puntos):
#   IP 203.0.113.10  ->  DOMAIN=203-0-113-10.sslip.io
DOMAIN=

# Clave del panel de administración (setup.sh genera una aleatoria). No la subas al repositorio.
ADMIN_API_KEY=

# Modelo de 3B: cabe en 4 GB de RAM y va unas 2,5 veces más rápido que el de 8B.
CHATBOT_MODEL_NAME=Llama-3.2-3B-Instruct-Q4_K_M.gguf
CHATBOT_BACKEND=meta-llama
CHATBOT_CONTEXT_WINDOW=4096
CHATBOT_GENERATE_TIMEOUT=90
CHATBOT_MAX_FAQS=3

# Webs que pueden incrustar el widget (separadas por comas). demo.html en el propio VPS no lo necesita.
CHATBOT_CORS_ORIGINS=https://ignaciopiles.vercel.app

# Demo pública: pocos mensajes por IP para que nadie acapare el modelo.
CHATBOT_RATE_LIMIT_PER_MIN=10
