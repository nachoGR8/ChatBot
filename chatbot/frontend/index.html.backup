    <footer>
        © <script>document.write(new Date().getFullYear());</script> Chatbot AI · Hecho con ❤️ en España · <a href="mailto:hola@chatbot.ai">hola@chatbot.ai</a>
    </footer>

    <script>
        // Configuración con detección automática
        function resolveApiUrl() {
            if (window.CHATBOT_API_URL) {
                return window.CHATBOT_API_URL;
            }

            try {
                const origin = window.location.origin;
                if (origin && origin !== 'null' && !origin.startsWith('file:')) {
                    return origin;
                }
            } catch (err) {
                console.warn('No se pudo usar window.location.origin para API_URL', err);
            }

            return 'http://localhost:8000';
        }

        const API_URL = resolveApiUrl();
        let BUSINESS_ID = 1; // Por defecto, se actualizará si es necesario
        const SESSION_STORAGE_PREFIX = 'chatbot_session_';

        const generateSessionId = () => 'user-' + Math.random().toString(36).substr(2, 9) + '-' + Date.now();

        function ensureSessionId(businessId) {
            const key = `${SESSION_STORAGE_PREFIX}${businessId}`;
            let sessionId = generateSessionId();
            try {
                const stored = window.localStorage.getItem(key);
                if (stored) {
                    sessionId = stored;
                } else {
                    window.localStorage.setItem(key, sessionId);
                }
            } catch (err) {
                console.warn('No se pudo acceder a localStorage, se usará sesión temporal.', err);
                sessionId = generateSessionId();
            }
            return sessionId;
        }

        let SESSION_ID = ensureSessionId(BUSINESS_ID);
        let apiAvailable = false;

        function fetchWithTimeout(resource, options = {}) {
            const { timeout = 3000, ...rest } = options;

            const supportsAbortTimeout = typeof AbortSignal !== 'undefined' && typeof AbortSignal.timeout === 'function';
            if (supportsAbortTimeout) {
                return fetch(resource, { ...rest, signal: AbortSignal.timeout(timeout) });
            }

            if (typeof AbortController === 'undefined') {
                return fetch(resource, rest);
            }

            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), timeout);
            return fetch(resource, { ...rest, signal: controller.signal })
                .then((response) => {
                    clearTimeout(timer);
                    return response;
                })
                .catch((error) => {
                    clearTimeout(timer);
                    throw error;
                });
        }

        // Verificar conexión con el backend
        async function checkBackend() {
            try {
                const response = await fetchWithTimeout(`${API_URL}/health`, {
                    method: 'GET',
                    timeout: 3000
                });
                
                if (response.ok) {
                    apiAvailable = true;
                    console.log('✅ Backend conectado');
                    
                    // Intentar inicializar datos demo
                    try {
                        const seedResponse = await fetchWithTimeout(`${API_URL}/seed-demo`, { method: 'POST', timeout: 5000 });
                        if (seedResponse.ok) {
                            const data = await seedResponse.json();
                            if (data.business_id) {
                                BUSINESS_ID = data.business_id;
                                SESSION_ID = ensureSessionId(BUSINESS_ID);
                            }
                        }
                    } catch (e) {
                        // Silently fail, demo data might already exist
                    }
                    
                    return true;
                }
            } catch (error) {
                console.warn('⚠️ Backend no disponible:', error.message);
            }
            
            apiAvailable = false;
            return false;
        }

        // Toggle chat window
        function toggleChat() {
            const chatWindow = document.getElementById('chat-window');
            chatWindow.classList.toggle('active');
            
            if (chatWindow.classList.contains('active')) {
                document.getElementById('chat-input').focus();
                if (!apiAvailable) {
                    checkBackend().then(available => {
                        if (!available) {
                            addMessage('El backend no está disponible. Por favor, ejecuta el script start-chatbot.ps1 primero.');
                        }
                    });
                }
            }
        }

        function openChat() {
            document.getElementById('chat-window').classList.add('active');
            document.getElementById('chat-input').focus();
        }

        // Handle enter key
        function handleKeyPress(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                sendMessage();
            }
        }

        // Renderizador de Markdown
        function renderMarkdown(text) {
            console.log('🔍 Texto original recibido:', text);
            let html = text;

            // Limpiar símbolos problemáticos del PDF
            html = html.replace(/■/g, '-');
            
            // PASO 1: Guardar tablas temporalmente (antes de procesar párrafos)
            const tables = [];
            
            // Estrategia nueva: buscar líneas con pipes y construir tablas manualmente
            const lines = html.split('\n');
            let inTable = false;
            let tableLines = [];
            let processedLines = [];
            
            console.log('🔍 Buscando tablas línea por línea...');
            
            for (let i = 0; i < lines.length; i++) {
                const line = lines[i].trim();
                const hasPipes = line.includes('|') && line.split('|').length >= 3;
                const isSeparator = /^\|[\s\-:]+\|/.test(line);
                
                if (hasPipes) {
                    if (!inTable) {
                        inTable = true;
                        tableLines = [line];
                        console.log(`� Inicio de tabla en línea ${i}:`, line);
                    } else {
                        tableLines.push(line);
                    }
                } else if (inTable && tableLines.length > 2) {
                    // Fin de tabla - procesarla
                    console.log(`✅ Tabla completa con ${tableLines.length} líneas`);
                    const tableHtml = buildTableFromLines(tableLines);
                    const placeholder = `__TABLE_${tables.length}__`;
                    tables.push(tableHtml);
                    processedLines.push(placeholder);
                    
                    inTable = false;
                    tableLines = [];
                    processedLines.push(line);
                } else {
                    if (inTable) {
                        // Línea vacía dentro de tabla - ignorar
                        if (line === '') continue;
                        inTable = false;
                        tableLines = [];
                    }
                    processedLines.push(lines[i]); // Preservar línea original sin trim
                }
            }
            
            // Si quedó una tabla al final
            if (inTable && tableLines.length > 2) {
                const tableHtml = buildTableFromLines(tableLines);
                const placeholder = `__TABLE_${tables.length}__`;
                tables.push(tableHtml);
                processedLines.push(placeholder);
            }
            
            html = processedLines.join('\n');
            console.log(`📊 Total de tablas encontradas: ${tables.length}`);
                
                try {
                    const headerCells = header.split('|')
                        .map(cell => cell.trim())
                        .filter(cell => cell && !cell.match(/^[\-:]+$/));
                    
                    const rowsArray = rows.trim().split('\n')
                        .map(row => row.split('|')
                            .map(cell => cell.trim())
                            .filter(cell => cell)
                        )
                        .filter(row => row.length > 0 && !row.every(cell => cell.match(/^[\s\-:]+$/)));

                    if (headerCells.length === 0 || rowsArray.length === 0) return match;

                    let tableHtml = '<table style="width:100%;border-collapse:collapse;margin:12px 0;font-size:0.85em;background:rgba(255,255,255,0.95);border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.1)">';
                    
                    // Header
                    tableHtml += '<thead><tr style="background:linear-gradient(135deg, #6366f1, #8b5cf6);color:white;text-align:left;font-weight:600">';
                    headerCells.forEach(cell => {
                        tableHtml += `<th style="padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.2);white-space:nowrap">${cell}</th>`;
                    });
                    tableHtml += '</tr></thead>';

                    // Body
                    tableHtml += '<tbody>';
                    rowsArray.forEach((row, idx) => {
                        const bgColor = idx % 2 === 0 ? 'rgba(99,102,241,0.05)' : 'white';
                        tableHtml += `<tr style="background:${bgColor};transition:background 0.2s" onmouseover="this.style.background='rgba(99,102,241,0.1)'" onmouseout="this.style.background='${bgColor}'">`;
                        row.forEach((cell, cellIdx) => {
                            if (cellIdx < headerCells.length) {
                                tableHtml += `<td style="padding:10px 12px;border-bottom:1px solid rgba(0,0,0,0.05);color:#333">${cell}</td>`;
                            }
                        });
                        tableHtml += '</tr>';
                    });
                    tableHtml += '</tbody></table>';

                    // Guardar la tabla y reemplazar con un marcador
                    const placeholder = `__TABLE_${tables.length}__`;
                    tables.push(tableHtml);
                    console.log(`📦 Tabla guardada como ${placeholder}`);
                    return placeholder;
                } catch (e) {
                    console.error('❌ Error rendering table:', e);
                    return match;
                }
            });

            console.log(`📊 Total de tablas encontradas: ${matchCount}`);
            console.log('📝 HTML después de procesar tablas:', html);

            // PASO 2: Limpiar pipes sueltos
            html = html.replace(/(\|\s*){5,}$/gm, '');

            // PASO 3: Bold
            html = html.replace(/\*\*(.+?)\*\*/g, '<strong style="color:#6366f1;font-weight:600">$1</strong>');

            // PASO 4: Listas
            html = html.replace(/^[\*\-] (.+)$/gm, '<li style="margin:4px 0;line-height:1.5">$1</li>');
            html = html.replace(/((?:<li[^>]*>.*?<\/li>\s*)+)/g, '<ul style="margin:8px 0;padding-left:20px;list-style-type:disc">$1</ul>');

            // PASO 5: Saltos de línea simples = <br>
            html = html.replace(/\n/g, '<br>');

            // PASO 6: Restaurar las tablas
            tables.forEach((table, idx) => {
                html = html.replace(`__TABLE_${idx}__`, table);
                console.log(`🔄 Tabla ${idx} restaurada`);
            });

            console.log('✨ HTML final:', html);
            return html;
        }

        // Add message to chat
        function addMessage(message, isUser = false) {
            const messagesContainer = document.getElementById('chat-messages');
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${isUser ? 'user' : 'bot'}`;
            
            const bubble = document.createElement('div');
            bubble.className = 'message-bubble';
            
            // Si es mensaje del bot, renderizar Markdown
            if (!isUser) {
                bubble.innerHTML = renderMarkdown(message);
            } else {
                // Si es del usuario, solo texto plano (seguridad)
                bubble.textContent = message;
            }
            
            messageDiv.appendChild(bubble);
            messagesContainer.appendChild(messageDiv);
            
            // Scroll to bottom
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        // Show/hide typing indicator
        function setTyping(isTyping) {
            const typingIndicator = document.getElementById('typing-indicator');
            const sendBtn = document.getElementById('send-btn');
            const input = document.getElementById('chat-input');
            
            if (isTyping) {
                typingIndicator.classList.add('active');
                sendBtn.disabled = true;
                input.disabled = true;
            } else {
                typingIndicator.classList.remove('active');
                sendBtn.disabled = false;
                input.disabled = false;
            }
        }

        // Send message to backend
        async function sendMessage() {
            const input = document.getElementById('chat-input');
            const message = input.value.trim();
            
            if (!message) return;
            
            // Check backend first
            if (!apiAvailable) {
                const isAvailable = await checkBackend();
                if (!isAvailable) {
                    addMessage('El backend no está disponible. Ejecuta start-chatbot.ps1 para iniciar el servidor.');
                    return;
                }
            }
            
            // Add user message
            addMessage(message, true);
            input.value = '';
            
            // Show typing indicator
            setTyping(true);
            
            try {
                const response = await fetchWithTimeout(`${API_URL}/chat`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        business_id: BUSINESS_ID,
                        session_id: SESSION_ID,
                        message: message
                    }),
                    timeout: 20000
                });
                
                if (!response.ok) {
                    throw new Error(`Error ${response.status}: ${response.statusText}`);
                }
                
                const data = await response.json();
                
                // Simulate typing delay
                setTimeout(() => {
                    setTyping(false);
                    addMessage(data.response);
                }, 1000);
                
            } catch (error) {
                console.error('Error:', error);
                setTyping(false);
                
                if (error.name === 'AbortError') {
                    addMessage('La respuesta tardó demasiado. Por favor, intenta de nuevo.');
                } else {
                    addMessage('Ha ocurrido un error. Verifica que el backend esté corriendo (start-chatbot.ps1).');
                }
                
                apiAvailable = false;
            }
        }

        // Initialize on load
        window.addEventListener('load', () => {
            console.log('🚀 Chat widget cargado');
            console.log('📍 Session ID:', SESSION_ID);
            console.log('🔌 API URL:', API_URL);
            
            // Check backend availability
            checkBackend();
        });
    </script>
</body>
</html>